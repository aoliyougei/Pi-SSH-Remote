{
  "name": "@aoliyougei/pi-background-tasks",
  "version": "2.1.1",
  "private": true,
  "description": "Background commands and attachable PTY/TUI sessions for Pi, with SSH Remote integration",
  "type": "module",
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "piBuild": {
    "bundlePackages": [
      "@aoliyougei/pi-shared-settings"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "background-tasks",
    "pty",
    "tui",
    "ssh",
    "remote-terminal"
  ],
  "author": "aoliyougei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoliyougei/Pi-SSH-Remote.git",
    "directory": "extensions/background-tasks"
  },
  "bugs": {
    "url": "https://github.com/aoliyougei/Pi-SSH-Remote/issues"
  },
  "homepage": "https://github.com/aoliyougei/Pi-SSH-Remote#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@aoliyougei/pi-shared-settings": "0.1.4",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.2.0-beta.14"
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
