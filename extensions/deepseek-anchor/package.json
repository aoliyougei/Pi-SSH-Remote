{
  "name": "@aoliyougei/pi-deepseek-anchor",
  "version": "0.1.0",
  "private": true,
  "description": "Simulate DSH minimal mode's first request to induce a stronger DeepSeek V4 Pro agent trajectory",
  "type": "module",
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "piBuild": {
