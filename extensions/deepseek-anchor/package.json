      "README.zh-CN.md"
    ],
    "bundlePackages": [
      "@aoliyougei/pi-shared-settings"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "deepseek",
    "harness",
    "reasoning",
    "anchored-standard"
  ],
  "author": "aoliyougei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoliyougei/Pi-SSH-Remote.git",
    "directory": "extensions/deepseek-anchor"
  },
  "bugs": {
    "url": "https://github.com/aoliyougei/Pi-SSH-Remote/issues"
  },
  "homepage": "https://github.com/aoliyougei/Pi-SSH-Remote#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@aoliyougei/pi-shared-settings": "0.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
